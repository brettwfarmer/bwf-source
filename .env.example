# BWF bwf-source — local credentials template
#
# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# These are used only for local read-only verification (routes.yaml tag slugs).
# No credential here is used to write to, or deploy to, the live site.

# Ghost Content API — READ-ONLY. Safe-ish (Ghost exposes it to front-end JS),
# but still treated as a secret here so it is not published in the repo.
# Ghost Admin > Settings > Integrations > your integration > Content API key
GHOST_CONTENT_API_KEY=
GHOST_API_URL=https://brettwfarmer.ghost.io
GHOST_API_VERSION=v5.0

# Ghost ADMIN API key — DO NOT ADD unless a task genuinely requires writes.
# Admin keys can modify the live site. Cutover is performed by hand in Ghost
# Admin per the ghost-deploy-qa runbook, so this should normally stay empty.
# GHOST_ADMIN_API_KEY=
